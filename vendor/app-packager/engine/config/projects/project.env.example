# 复制本文件为 config/projects/<项目ID>.env 后按实际环境填写。
# config/projects/*.env 已被 .gitignore 忽略，不会上传到 GitHub。

PROJECT_ID="my-project"
SOURCE_DIR="/absolute/path/to/uni-app-x-project"
HX_PROJECT_NAME="my-project-build"
APP_NAME="my-project"

# iOS 签名信息，可按实际 Profile 修改。
EXPECTED_BUNDLE_ID="com.example.myapp"
EXPECTED_TEAM_ID="YOUR_TEAM_ID"
PROFILE_FILE="$PIPELINE_ROOT/signing/current/my-project.mobileprovision"
SCHEME="UniAppX"
CONFIGURATION="Release"
BUILD_SCRIPT_RELATIVE="scripts/ios-package/build-adhoc-ipa.sh"

# 平台开关。
IOS_ENABLED="true"
ANDROID_ENABLED="true"
ANDROID_MODULE_DIR="app-android"
# 可选：Android release 签名配置。推荐按项目放置：
# certificates/Android/<项目ID>/release.keystore
# certificates/Android/<项目ID>/keystore.properties
# ANDROID_KEYSTORE_PROPERTIES="$PIPELINE_ROOT/certificates/Android/my-project/keystore.properties"
HARMONY_ENABLED="true"

# 可选：覆盖 HarmonyOS HAP versionCode（正整数）。
# 蒲公英版本签名配置变化导致 17700015 时，需要递增此值。
# HARMONY_VERSION_CODE="101"
