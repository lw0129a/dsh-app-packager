# 本机并行构建覆盖配置示例
# 复制为 config/parallel.local.env 后按机器性能调整；不要提交本机配置。

# 保守模式：完全不并行
# PARALLEL_BUILD_ENABLED="false"

# 固定总并发为 2
# PARALLEL_MAX_JOBS="2"

# 高性能机器可提升到 3 或 4，但不建议超过 4。
# PARALLEL_MAX_JOBS="3"

# 默认保护：HBuilderX/Xcode/Gradle 分别只允许 1 个重型任务。
# PARALLEL_MAX_HBULDERX_JOBS="1"
# PARALLEL_MAX_XCODE_JOBS="1"
# PARALLEL_MAX_GRADLE_JOBS="1"
# PARALLEL_MAX_PREPARE_JOBS="2"
# PARALLEL_MAX_UPLOAD_JOBS="2"
# PARALLEL_LIVE_QUEUE_DISPLAY="true"
