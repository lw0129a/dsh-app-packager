# AppPackager 安装包上传配置
# 本文件用于人工维护“上传平台注册”和通用上传参数，不包含密钥。
# 本机 API Key、Token、证书密码等敏感信息请写入 config/upload.local.env。

# ============================================================
# 上传平台总清单
# ============================================================
# 已接入：pgyer
# 已预留配置：appstore、huawei、xiaomi、yingyongbao
# 未实现的平台默认 ENABLED=false，不会出现在打包后的上传菜单中。
# 平台 ID 只使用字母、数字和下划线。
UPLOAD_PLATFORM_IDS="pgyer appstore huawei xiaomi yingyongbao"

# ============================================================
# 蒲公英
# ============================================================
UPLOAD_PLATFORM_pgyer_NAME="蒲公英"
UPLOAD_PLATFORM_pgyer_ENABLED="true"
UPLOAD_PLATFORM_pgyer_PLATFORMS="ios android harmony"
UPLOAD_PLATFORM_pgyer_SCRIPT="lib/uploaders/pgyer.sh"
UPLOAD_PLATFORM_pgyer_FUNCTION="upload_pgyer_artifact"
# 面板「打包选项 → 蒲公英」里填的 API Key 存进 config/upload.local.env 的这个变量
UPLOAD_PLATFORM_pgyer_API_KEY_VAR="PGYER_API_KEY"

# 蒲公英官方 CLI（@pgyer/cli，命令名 pgyer）：不上全局安装，第一次真的要上传蒲公英时
# 才装进引擎目录的 tools/pgyer-cli；iOS/Android 的快速上传走它。
PGYER_CLI_PACKAGE="${PGYER_CLI_PACKAGE:-@pgyer/cli}"
PGYER_CLI_VERSION="${PGYER_CLI_VERSION:-0.1.5}"

# 蒲公英 API 地址和 Keychain 服务名（HarmonyOS HAP 还要上传 P12 证书，仍走接口上传）
PGYER_API_KEY_SERVICE="${PGYER_API_KEY_SERVICE:-app-packager-pgyer}"
PGYER_GET_COS_TOKEN_URL="${PGYER_GET_COS_TOKEN_URL:-https://www.pgyer.com/apiv2/app/getCOSToken}"
PGYER_BUILD_INFO_URL="${PGYER_BUILD_INFO_URL:-https://www.pgyer.com/apiv2/app/buildInfo}"
PGYER_HARMONY_CERT_UPLOAD_URL="${PGYER_HARMONY_CERT_UPLOAD_URL:-https://upload.pgyer.com/apiv2/app/uploadHarmonyCert}"
PGYER_HARMONY_P12_PASSWORD_SERVICE="${PGYER_HARMONY_P12_PASSWORD_SERVICE:-app-packager-pgyer-harmony-p12}"

# 蒲公英上传和发布状态轮询参数
PGYER_UPLOAD_TIMEOUT_SECONDS="${PGYER_UPLOAD_TIMEOUT_SECONDS:-600}"
PGYER_POLL_TIMEOUT_SECONDS="${PGYER_POLL_TIMEOUT_SECONDS:-300}"
PGYER_POLL_INTERVAL_SECONDS="${PGYER_POLL_INTERVAL_SECONDS:-3}"

# 可选：蒲公英安装方式、安装密码、更新说明
PGYER_BUILD_INSTALL_TYPE="${PGYER_BUILD_INSTALL_TYPE:-}"
PGYER_BUILD_PASSWORD="${PGYER_BUILD_PASSWORD:-}"
PGYER_BUILD_UPDATE_DESCRIPTION="${PGYER_BUILD_UPDATE_DESCRIPTION:-}"

# 兼容 uni-platform-app 的蒲公英配置字段
PGYER_UPDATE_DESCRIPTION="${PGYER_UPDATE_DESCRIPTION:-}"
# ============================================================
# App Store / App Store Connect
# ============================================================
# 预留配置。实现 App Store Connect 上传 provider 后再启用。
UPLOAD_PLATFORM_appstore_NAME="App Store"
UPLOAD_PLATFORM_appstore_ENABLED="false"
UPLOAD_PLATFORM_appstore_PLATFORMS="ios"
UPLOAD_PLATFORM_appstore_SCRIPT="lib/uploaders/appstore.sh"
UPLOAD_PLATFORM_appstore_FUNCTION="upload_appstore_artifact"

# App Store Connect API Key 本机配置建议放在 config/upload.local.env：
# APPSTORE_API_KEY_ID=""
# APPSTORE_API_ISSUER_ID=""
# APPSTORE_API_PRIVATE_KEY_PATH=""
# APPSTORE_BUNDLE_ID_OVERRIDE=""

# ============================================================
# 华为应用市场 / AppGallery Connect
# ============================================================
# 预留配置。实现 AGC 发布 API provider 后再启用。
UPLOAD_PLATFORM_huawei_NAME="华为应用市场"
UPLOAD_PLATFORM_huawei_ENABLED="false"
UPLOAD_PLATFORM_huawei_PLATFORMS="android harmony"
UPLOAD_PLATFORM_huawei_SCRIPT="lib/uploaders/huawei-appgallery.sh"
UPLOAD_PLATFORM_huawei_FUNCTION="upload_huawei_appgallery_artifact"

# 华为 AGC 本机配置建议放在 config/upload.local.env：
# HUAWEI_APPGALLERY_CLIENT_ID=""
# HUAWEI_APPGALLERY_CLIENT_SECRET=""
# HUAWEI_APPGALLERY_APP_ID=""

# ============================================================
# 小米应用市场
# ============================================================
# 预留配置。实现小米开放平台上传 provider 后再启用。
UPLOAD_PLATFORM_xiaomi_NAME="小米应用市场"
UPLOAD_PLATFORM_xiaomi_ENABLED="false"
UPLOAD_PLATFORM_xiaomi_PLATFORMS="android"
UPLOAD_PLATFORM_xiaomi_SCRIPT="lib/uploaders/xiaomi.sh"
UPLOAD_PLATFORM_xiaomi_FUNCTION="upload_xiaomi_artifact"

# 小米开放平台本机配置建议放在 config/upload.local.env：
# XIAOMI_APP_ID=""
# XIAOMI_APP_KEY=""
# XIAOMI_APP_SECRET=""

# ============================================================
# 腾讯应用宝
# ============================================================
# 预留配置。实现应用宝开放平台上传 provider 后再启用。
UPLOAD_PLATFORM_yingyongbao_NAME="应用宝"
UPLOAD_PLATFORM_yingyongbao_ENABLED="false"
UPLOAD_PLATFORM_yingyongbao_PLATFORMS="android"
UPLOAD_PLATFORM_yingyongbao_SCRIPT="lib/uploaders/yingyongbao.sh"
UPLOAD_PLATFORM_yingyongbao_FUNCTION="upload_yingyongbao_artifact"

# 应用宝开放平台本机配置建议放在 config/upload.local.env：
# YINGYONGBAO_APP_ID=""
# YINGYONGBAO_SECRET_KEY=""
