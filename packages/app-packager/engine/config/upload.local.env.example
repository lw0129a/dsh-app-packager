# 本机上传密钥配置示例
# 复制为 config/upload.local.env 后填写；不要提交到 GitHub。

# ============================================================
# 蒲公英
# ============================================================
# PGYER_API_KEY=""
# 可选：蒲公英版本更新说明；兼容原 uni-platform-app 配置字段
# PGYER_UPDATE_DESCRIPTION=""
# HarmonyOS HAP 上传蒲公英时使用的 P12 明文密码。
# 不能填写 manifest.json 中 HBuilderX 加密后的 storePassword。
# PGYER_HARMONY_P12_PASSWORD=""

# ============================================================
# App Store / App Store Connect
# ============================================================
# APPSTORE_API_KEY_ID=""
# APPSTORE_API_ISSUER_ID=""
# APPSTORE_API_PRIVATE_KEY_PATH=""
# APPSTORE_BUNDLE_ID_OVERRIDE=""

# ============================================================
# 华为应用市场 / AppGallery Connect
# ============================================================
# HUAWEI_APPGALLERY_CLIENT_ID=""
# HUAWEI_APPGALLERY_CLIENT_SECRET=""
# HUAWEI_APPGALLERY_APP_ID=""

# ============================================================
# 小米应用市场
# ============================================================
# XIAOMI_APP_ID=""
# XIAOMI_APP_KEY=""
# XIAOMI_APP_SECRET=""

# ============================================================
# 腾讯应用宝
# ============================================================
# YINGYONGBAO_APP_ID=""
# YINGYONGBAO_SECRET_KEY=""
