# 基础路径
HBUILDERX_APP="/Applications/HBuilderX.app"
HBUILDERX_CLI="$HBUILDERX_APP/Contents/MacOS/cli"
WORK_ROOT="$PIPELINE_ROOT/workspaces"
LOG_ROOT="$PIPELINE_ROOT/logs"
SIGNING_ROOT="$PIPELINE_ROOT/signing/current"

# 通用安装包仓库，后续可同时存放 iOS、Android、HarmonyOS 包。
PACKAGE_ROOT="$PIPELINE_ROOT/packages"
PACKAGE_IOS_DIR="$PACKAGE_ROOT/iOS"
PACKAGE_ANDROID_DIR="$PACKAGE_ROOT/Android"
PACKAGE_HARMONY_DIR="$PACKAGE_ROOT/HarmonyOS"
KEEP_BUILD_COUNT=5
KEEP_LOG_COUNT=5
# true: 保留 sdk/ 根目录原始包和 sdk/_processed/ 备份，便于回滚。
KEEP_SDK_ARCHIVES="true"
# manifest-direct: 直接使用 uni-app 配置；disabled: 不做任何图标/启动页替换。
BRAND_ASSET_MODE="manifest"

# 本地 UniAppX iOS 离线 SDK，不依赖 Git。
LOCAL_IOS_SDK_DIR="$PIPELINE_ROOT/sdk/iOS/5.26"
LOCAL_ANDROID_SDK_DIR="$PIPELINE_ROOT/sdk/Android/5.26"
LOCAL_HARMONY_SDK_DIR="$PIPELINE_ROOT/sdk/HarmonyOS/5.26"
LOCAL_IOS_RUNTIME_VERSION="5.26"
HARMONY_RUNTIME_VERSION="5.26"
APPLE_CERTS_DIR="$PIPELINE_ROOT/signing/apple"

# 共享签名证书和 Keychain 密码服务名
P12_FILE="$SIGNING_ROOT/cert.p12"
P12_PASSWORD_SERVICE="anjuyi-ios-p12"

# 构建工作区保留策略。true 表示保留，便于排查；默认每次重建。
KEEP_WORKSPACE="false"

# 可选：将最新 IPA 复制到静态目录，并给出可下载 URL。
# PUBLISH_DIR="/path/to/web/downloads"
# PUBLIC_BASE_URL="https://example.com/downloads"

# iOS 自定义 UTS 插件联编: 将 uni_modules/*/utssdk/app-ios 源码挂到 SDK 已联编的 UTS 宿主 target，并在 IPA 归档后校验类是否存在。
IOS_CUSTOM_UTS_INTEGRATION="true"

# 权限策略: full 会把常用业务权限和隐私说明合并进隔离构建副本；off 保持项目原配置。
FULL_PERMISSION_PROFILE="true"
# Android 首次启动统一申请权限；iOS 依赖 Info.plist 用途说明在首次使用能力时提示。
FULL_PERMISSION_PROMPT="true"
FULL_ANDROID_PERMISSIONS_FILE="$PIPELINE_ROOT/config/permissions/full-android-permissions.json"
FULL_IOS_PRIVACY_FILE="$PIPELINE_ROOT/config/permissions/full-ios-privacy.json"

# Android 本地构建配置
ANDROID_SDK_DIR="$HOME/Library/Android/sdk"
# 留空时自动查找 ~/.gradle 中已缓存的 Gradle 可执行文件。
ANDROID_GRADLE_BIN=""
# false: 使用 ANDROID_GRADLE_BIN/本机缓存，保持 AppPackager 已验证组合。
# true: 优先使用业务项目 app-android/gradlew（首次使用可能需要下载 wrapper 发行版）。
ANDROID_USE_PROJECT_WRAPPER="false"

# AppPackager 已验证的 Android Gradle Plugin 版本；留空时保留业务项目版本。
ANDROID_AGP_VERSION="9.3.2"

# HarmonyOS 本地打包。签名配置完全以项目 manifest 的 app-harmony.signingConfigs 为准；
# certificates/HarmonyOS 只提供同名文件用于原样补齐。
HARMONY_SIGNING_CERT_DIR="$PIPELINE_ROOT/certificates/HarmonyOS"
HARMONY_P12_PASSWORD_SERVICE="anjuyi-harmony-p12"
HARMONY_KEY_ALIAS="release"
HARMONY_SIGN_ALG="SHA256withECDSA"
# HarmonyOS 只归档 HBuilderX 生成的 signed HAP；不再提供 unsigned 回退。

# [TEMP-10021] HarmonyOS 测试侧载模式（默认关闭）。
# false: 正常 harmony 打包使用项目 signingConfigs.release。
# true:  仅未选择上传平台时改用 default debug，生成 latest-install.hap。
# debug 侧载仍可显式使用 --harmony-debug。
HARMONY_TEMP_FORCE_INSTALL_SIGNING="false"

# [PGYER-17700015] 蒲公英 HarmonyOS 安装兼容模式。
# false: 使用 release HAP + internaltesting 签名，并把 targetSdkVersion
# 对齐蒲公英 manifest 的 5.0.1(13)，避免系统报 17700015。
HARMONY_PGYER_DEBUGGABLE="false"

# [PGYER-17700015] 蒲公英安装 manifest 使用的目标 API 版本。
# 当前固定为项目的最低兼容版本 5.0.1(13)，避免 HAP targetAPI=26
# 与蒲公英 manifest targetAPI=13 不一致导致 17700015。
HARMONY_PGYER_TARGET_SDK_VERSION="5.0.1(13)"

# 并行构建配置位于 config/parallel.env 和 config/parallel.local.env。
# 安装包上传配置位于 config/upload.env 和 config/upload.local.env。
