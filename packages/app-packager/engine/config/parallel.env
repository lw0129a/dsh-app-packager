# AppPackager 并行构建配置
# 目标：多项目/多平台并行，但严格限制 HBuilderX、Xcode、Gradle 和整机资源占用。

# true: 多任务时启用并行调度；false: 始终顺序执行。
PARALLEL_BUILD_ENABLED="true"

# true: 根据 CPU/内存自动计算总并发；false: 使用保守默认值或显式数字。
PARALLEL_AUTO_TUNE="true"

# 总并发任务数；auto 时按性能自动计算。
PARALLEL_MAX_JOBS="auto"

# 单平台并发任务数；auto 时使用总并发值，显式数字时按数字限制。
# 默认允许两个同平台任务进入流水线，重型工具仍会串行保护。
PARALLEL_MAX_IOS_JOBS="2"
PARALLEL_MAX_ANDROID_JOBS="2"
PARALLEL_MAX_HARMONY_JOBS="2"

# 重型工具硬限制。默认全部为 1，避免编辑器或构建器互相争抢。
# 尤其不建议把 HBuilderX 改成大于 1。
PARALLEL_MAX_HBULDERX_JOBS="1"
PARALLEL_MAX_XCODE_JOBS="1"
PARALLEL_MAX_GRADLE_JOBS="1"
# 工作区和安装包上传的阶段并发，不涉及 HBuilderX/Xcode/Gradle 同时执行。
PARALLEL_MAX_PREPARE_JOBS="2"
PARALLEL_MAX_UPLOAD_JOBS="2"

# 自动调优上限和资源保护参数。
# 默认自动并发上限为 3；确认机器资源充足时可调高。
PARALLEL_AUTO_JOBS_MAX="3"
PARALLEL_RESERVED_CPU_CORES="1"
PARALLEL_MEMORY_PER_JOB_MB="4096"

# Gradle 单个进程的最大 worker 数。默认 2，避免占用整机所有 CPU。
PARALLEL_GRADLE_WORKERS="2"

# 调度参数。
PARALLEL_QUEUE_POLL_SECONDS="1"
PARALLEL_QUEUE_REFRESH_SECONDS="1"
# true: 在终端显示实时队列、进度条和状态；false: 只输出开始/结束信息。
PARALLEL_LIVE_QUEUE_DISPLAY="true"
PARALLEL_FAIL_FAST="false"
# true: 子任务日志直接混合输出；false: 每个任务单独控制台日志，失败时自动 tail。
PARALLEL_PRINT_CHILD_LOGS="false"
