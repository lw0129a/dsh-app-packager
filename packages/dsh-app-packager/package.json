{
  "name": "dsh-app-packager",
  "version": "0.6.1",
  "description": "AppPackager for DeepSeek Harness: list uni-app x projects, check the local toolchain, and build iOS / Android / HarmonyOS packages on macOS, Windows and Linux.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "app-packager",
    "uni-app-x",
    "hBuilderX",
    "ios",
    "android",
    "harmonyos",
    "ipa",
    "apk",
    "hap"
  ],
  "homepage": "https://github.com/lw0129a/dsh-app-packager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw0129a/dsh-app-packager.git",
    "directory": "packages/dsh-app-packager"
  },
  "bugs": {
    "url": "https://github.com/lw0129a/dsh-app-packager/issues"
  },
  "author": "lw0129a",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web": "./web.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "web.js",
    "client.js",
    "upgrade.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "native-code:none",
      "network:outbound-optional"
    ],
    "capability": {
      "id": "app-packager",
      "kind": "tools+panel",
      "invocation": "mount the dsh-app-packager bundle row",
      "expected": "also reads the HBuilderX version, recommends the matching iOS / Android / HarmonyOS SDK downloads and installs them from the panel, and can upgrade the plugin while keeping the downloaded SDKs; exposes app_packager_list / app_packager_doctor / app_packager_check / app_packager_build, driving the bundled bash engine (or the Node half on Windows), plus an AppPackager panel in the web GUI (environment check, project list, builds with live logs and cancel)."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  },
  "dependencies": {
    "app-packager": "workspace:^0.6.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
