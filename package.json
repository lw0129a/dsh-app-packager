{
  "name": "app-packager-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for AppPackager: the cross-platform uni-app x packaging CLI and its DeepSeek Harness plugin.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "tsc -p tsconfig.scripts.json && node .scripts/check-no-local-config.js && pnpm -r test",
    "guard:check": "tsc -p tsconfig.scripts.json && node .scripts/check-no-local-config.js",
    "docs:check": "tsc -p tsconfig.scripts.json && node .scripts/check-docs.js",
    "cli": "pnpm -C packages/app-packager build && node packages/app-packager/dist/bin.js",
    "doctor": "pnpm -C packages/app-packager build && node packages/app-packager/dist/bin.js doctor",
    "list": "pnpm -C packages/app-packager build && node packages/app-packager/dist/bin.js list",
    "build": "pnpm -r build"
  },
  "keywords": [
    "uni-app-x",
    "packager",
    "dsh-plugin",
    "deepseek-harness",
    "ios",
    "android",
    "harmonyos"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
