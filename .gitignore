node_modules/
*.log
.DS_Store
.tmp/

# TypeScript build output (packages ship dist/ in the npm tarball)
packages/*/dist/
packages/*/dist-test/
# Engine copy vendored into the plugin at build time
packages/dsh-app-packager/vendor/
.scripts/

# Local AppPackager runtime state materialized by `app-packager init`
.app-packager/

# Secrets, signing material and installers must never reach the plugin repo
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
*.p7b
*.p8
*.pem
*.key
*.cer
!packages/app-packager/engine/signing/apple/*.cer
*.ipa
*.apk
*.hap
*.tgz
