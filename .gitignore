node_modules/
*.log
.DS_Store
.tmp/

# Engine build output; the plugin's own dist/ and vendor/ are committed so a
# `pnpm add <git url>` install works without a build step.
packages/app-packager/dist/
packages/app-packager/dist-test/
dist-test/
.scripts/

# Local AppPackager runtime state materialized by `app-packager init`
.app-packager/

# Secrets, signing material and installers must never reach the plugin repo
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
*.p7b
*.p8
*.pem
*.key
*.cer
!packages/app-packager/engine/signing/apple/*.cer
*.ipa
*.apk
*.hap
*.tgz
